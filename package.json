{
  "name": "BLADE_Alpha",
  "version": "0.2.0",
  "private": true,
  "description": "Offline staffing scheduler",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:win": "tauri build --bundles nsis",
    "build:function-coverage": "vite build --config vite.function-coverage.config.mjs",
    "build:lines-table": "vite build --config vite.lines-table.config.mjs",
    "build:setup-panel": "vite build --config vite.setup-panel.config.mjs",
    "build:coverage": "vite build --config vite.coverage.config.mjs",
    "build:team-builder": "vite build --config vite.team-builder.config.mjs",
    "build:reports": "vite build --config vite.reports.config.mjs",
    "build:demand-capacity": "vite build --config vite.demand-capacity.config.mjs",
    "build:shared": "vite build --config vite.shared.config.mjs",
    "build:modules": "npm run build:shared && npm run build:setup-panel && npm run build:coverage && npm run build:team-builder && npm run build:reports && npm run build:demand-capacity && npm run build:lines-table && npm run build:function-coverage",
    "copy-frontend": "node scripts/copy-frontend.js",
    "test": "node tests/test-task1.js && node tests/test-function-coverage.mjs && node tests/test-demand-capacity.mjs && node tests/test-coverage-cuts.mjs",
    "test:function-coverage": "node tests/test-function-coverage.mjs",
    "test:demand-capacity": "node tests/test-demand-capacity.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tanstack/svelte-virtual": "^3.13.39",
    "@tauri-apps/cli": "^2",
    "svelte": "^4.2.19",
    "vite": "^5.4.11"
  }
}
